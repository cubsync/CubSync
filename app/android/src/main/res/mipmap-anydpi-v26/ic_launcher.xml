<?xml version="1.0" encoding="utf-8"?>
<!--
  The finalised mark: a large body and a small one touching it, with a hole through
  the small one. The monochrome layer is what Android 13 and later use for themed
  icons, so the launcher can recolour it to match the wallpaper instead of showing a
  tile that fights it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
