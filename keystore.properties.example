# Template — copy to `keystore.properties` in the repository root and fill in.
#
# `keystore.properties` is gitignored and must never be committed. This file is the
# only one of the pair that belongs in the repository, so that a new checkout can see
# which keys are expected without any of the values.
#
# CI does not use this file: the release workflow writes it from repository secrets.
# See docs/SIGNING.md.
#
# storeFile is resolved against the repository root. An absolute path works too.
storeFile=keystore/cubsync-release.jks
storePassword=
keyAlias=cubsync
keyPassword=
